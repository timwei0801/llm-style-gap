# ============================================
# 🔐 API Keys — copy this to .env and fill in
# ============================================
# .env is in .gitignore. NEVER commit real keys.

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (GPT)
OPENAI_API_KEY=sk-xxxxx

# Google AI Studio (Gemini) — free tier
GOOGLE_API_KEY=AIzaXXXXX

# Groq (Llama, Kimi, gpt-oss, etc.) — free tier
GROQ_API_KEY=gsk_xxxxx

# Ollama Cloud (only if using Pro tier)
# OLLAMA_API_KEY=

# ============================================
# 🖥 Local Ollama (school GPU server)
# ============================================
OLLAMA_HOST=http://localhost:11434
# Or your school server IP if running remotely:
# OLLAMA_HOST=http://gpu-server.school.edu:11434

# ============================================
# 📊 Sampling Parameters (must be consistent across all models)
# ============================================
SAMPLE_TEMPERATURE=0.7
SAMPLE_TOP_P=0.95
SAMPLE_MAX_TOKENS=800
SAMPLE_NUM_RUNS=3

# ============================================
# 🔧 Other
# ============================================
LOG_LEVEL=INFO
DATA_DIR=./data
OUTPUT_DIR=./analysis
